# ── Email (Nodemailer SMTP) ────────────────────────────────────────────────────
# EMAIL_FROM_ADDRESS determines the SMTP host automatically:
#   *@outlook.com / @hotmail.com / @live.com → smtp.office365.com:587
#   *@gmail.com                              → smtp.gmail.com:587
#   anything else                            → smtp.<domain>:587
#
# Outlook app password: https://myaccount.microsoft.com → Security → App passwords
# Gmail app password  : https://myaccount.google.com/apppasswords (needs 2FA on)
#
# Override auto-detection by setting SMTP_HOST and SMTP_PORT explicitly.
EMAIL_FROM_NAME=KAVON
EMAIL_FROM_ADDRESS=hello.kavon.lk@gmail.com
EMAIL_SUPPORT_ADDRESS=hello.kavon.lk@gmail.com
EMAIL_PASSWORD=

# Optional overrides (leave blank to use auto-detected values above)
SMTP_HOST=
SMTP_PORT=

FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ── EmailJS (password-recovery only) ──────────────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_RECOVERY_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# ── Admin seed (optional) ─────────────────────────────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
